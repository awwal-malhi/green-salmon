# Copy to .env (git-ignored) or export these. Nothing here is secret.
# infra/deploy.sh writes .env.azure with the real values for Azure.

# Azure SQL / SQL Server
SQL_SERVER=localhost,14330
SQL_DATABASE=cdcdemo
SQL_USER=sa
SQL_PASSWORD=
# Optional: ODBC driver name, encryption, cert trust (local container only), auth mode.
# SQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
# SQL_TRUST_SERVER_CERTIFICATE=no
# SQL_AUTHENTICATION=ActiveDirectoryServicePrincipal   # then SQL_USER=<client id>, SQL_PASSWORD=<secret>

# Service Bus: either one connection string, or separate send/listen ones.
SERVICEBUS_QUEUE=cdc-changes
SERVICEBUS_CONNECTION_STRING=
# SERVICEBUS_SEND_CONNECTION_STRING=
# SERVICEBUS_LISTEN_CONNECTION_STRING=

# Infra scripts only
# AZURE_RESOURCE_GROUP=
# SQL_ADMIN_PASSWORD=
# AZURE_LOCATION=canadacentral
